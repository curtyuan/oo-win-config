<UserControl x:Class="OoWinConfig.Views.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource TabContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="16" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Remote profile management" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Future workflow for collecting and restoring software profile files through SSH. SSH settings are managed in the SSH Config tab." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="Open SSH Config" MinWidth="140" Margin="14,0,0,0" Click="OpenSshConfig_OnClick" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="1. SSH host source" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Use SSH Host cards as endpoints." FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Remote workflows should reference a Host card from SSH Config instead of editing host/user/key settings here." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Button Content="Manage SSH hosts" HorizontalAlignment="Left" Margin="0,16,0,0" Click="OpenSshConfig_OnClick" />
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="1" Header="2. Connect endpoint" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Connection flow planned." FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Later this tab can pick an SSH Host card, test the connection, and identify the remote OS before profile collection starts." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Border Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                        <TextBlock Text="No live remote session in this tab yet." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Column="2" Header="3. Collect and restore profiles">
                <StackPanel>
                    <TextBlock Text="Profile actions stay separate from SSH settings." FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="This future workspace will show remote software profiles, config items, baseline snapshots, collect, and restore actions." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <Border Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="10" Margin="0,16,0,0">
                        <TextBlock Text="Not implemented yet." Foreground="{StaticResource MutedTextBrush}" />
                    </Border>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
