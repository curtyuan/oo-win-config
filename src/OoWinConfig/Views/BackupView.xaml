<UserControl x:Class="OoWinConfig.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#111721" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="#111721" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#202a3d" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SnapshotCardToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#151d2a" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Width" Value="136" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1b2637" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderBrush" Value="#4ade80" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="#14251f" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource TabContentMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="0" Margin="0,0,10,0">
            <GroupBox.Header>
                <DockPanel LastChildFill="False">
                    <TextBlock x:Name="ProfilesHeaderText" Text="Softwares" VerticalAlignment="Center" />
                    <StackPanel x:Name="ProfileBulkActionsPanel" DockPanel.Dock="Right" Orientation="Horizontal" Margin="108,0,0,0">
                        <Button Content="All" ToolTip="Select all softwares" MinWidth="42" Height="24" Padding="6,0" Margin="0,0,4,0" Click="SelectAll_OnClick" />
                        <Button Content="Clear" ToolTip="Clear software selection" MinWidth="64" Height="24" Padding="8,0" Click="ClearAll_OnClick" />
                    </StackPanel>
                </DockPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_OnSelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="#111721" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ProfilesListItem_OnPreviewMouseLeftButtonUp" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#151d2a" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1c2740" />
                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelectedForSnapshotMap}" Value="True">
                                    <Setter Property="BorderBrush" Value="#22c55e" />
                                    <Setter Property="BorderThickness" Value="3" />
                                    <Setter Property="Background" Value="#111721" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelectedForBackup}" Checked="ProfileBackupSelection_OnChanged" Unchecked="ProfileBackupSelection_OnChanged" Margin="0,4,8,0">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSnapshotMapMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Id}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button x:Name="BackupProfilesButton" Grid.Row="1" Content="Backup profiles" Margin="0,10,0,0" IsEnabled="False" Click="BackupProfiles_OnClick" />
            </Grid>
        </GroupBox>

        <Grid Grid.Column="1" Margin="0,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="SnapshotSidebarColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0">
                <GroupBox.Header>
                <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button x:Name="SnapshotMapModeButton" Content="Snapshot map" MinWidth="116" Height="24" Padding="8,0" Margin="0,0,6,0" Click="SnapshotMapMode_OnClick" />
                        <Button x:Name="TrashMapModeButton" Content="Trash" MinWidth="72" Height="24" Padding="8,0" Click="TrashMapMode_OnClick" />
                    </StackPanel>
                    <TextBlock x:Name="ConfigHeaderText" Text="Selected profile config items" VerticalAlignment="Center" />
                </DockPanel>
                </GroupBox.Header>
            <Grid>
                <Grid x:Name="ConfigItemsPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="ConfigItemsList">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,4,8,0" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="Kind: " Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Kind}" />
                                            <TextBlock Text="  |  Status: " Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding StatusIcon}" Style="{StaticResource ConfigStatusIconStyle}" />
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{Binding Status}" />
                                            <TextBlock Text="  |  " Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding RequiredLabel}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SourcePath}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        <Button Content="{Binding RestoreActionLabel}" HorizontalAlignment="Left" MinWidth="150" Margin="0,8,0,0" Click="RestoreConfigItem_OnClick" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="Create backup" MinWidth="120" Margin="0,0,8,0" Click="CreateBackup_OnClick" />
                        <Button Content="Compare to stored config" MinWidth="190" Click="CompareToStoredConfig_OnClick" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="SnapshotMapPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Timeline" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer x:Name="SnapshotRowHeaderScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                                <ItemsControl x:Name="SnapshotRowHeadersItems" Margin="0,0,14,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Height="104" Margin="0,8,0,12">
                                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding ProfileId}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <ScrollViewer x:Name="SnapshotTimelineScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="Transparent" ScrollChanged="SnapshotTimelineScroll_OnScrollChanged">
                                <StackPanel>
                                    <ItemsControl x:Name="SnapshotDateColumnsItems" Margin="0,0,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="136" Margin="0,0,10,0" Padding="0,0,0,6" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding YearLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                                                        <TextBlock Text="{Binding MonthLabel}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <ItemsControl x:Name="SnapshotRowsItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding Snapshots}" Height="104" Margin="0,8,0,12">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <ToggleButton Style="{StaticResource SnapshotCardToggleStyle}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsSnapshot}" Margin="0,0,10,0" Checked="SnapshotCompareCard_OnChanged" Unchecked="SnapshotCompareCard_OnChanged">
                                                                <ToggleButton.ContextMenu>
                                                                    <ContextMenu>
                                                                        <MenuItem Header="Open in Explorer" Click="OpenSnapshotInExplorer_OnClick" />
                                                                    </ContextMenu>
                                                                </ToggleButton.ContextMenu>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                                                                    <TextBlock Text="{Binding ShortDate}" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                                                                    <TextBlock Text="{Binding Tag}" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0" />
                                                                </StackPanel>
                                                            </ToggleButton>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <TextBlock x:Name="SnapshotEmptyText" Grid.Column="1" Text="This profile has no snapshots yet." Visibility="Collapsed" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <StackPanel x:Name="TrashScopePanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                            <Button Content="General" MinWidth="72" Margin="0,0,6,0" Click="TrashScopeGeneral_OnClick" />
                            <Button Content="Remote" MinWidth="72" Click="TrashScopeRemote_OnClick" />
                        </StackPanel>
                    </Grid>

                </Grid>
            </Grid>
            </GroupBox>

            <Border x:Name="SnapshotSidebarPanel" Grid.Column="1" Visibility="Collapsed" Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="10" Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <Button x:Name="SnapshotSidebarToggleButton" DockPanel.Dock="Left" Content="›" ToolTip="Toggle sidebar (Ctrl+R)" FontSize="18" FontWeight="SemiBold" Width="28" Height="28" Padding="0" ToolTipService.ShowDuration="6000" Click="SnapshotSidebarToggle_OnClick" />
                        <TextBlock Text="Actions" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <Button x:Name="SnapshotCompareButton" Content="Compare" IsEnabled="False" Click="SnapshotCompare_OnClick" />
                        <Button x:Name="DeleteSnapshotButton" Content="Delete snapshot" IsEnabled="False" Margin="0,8,0,0" Click="DeleteSnapshot_OnClick" />

                        <Border BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,1,0,0" Margin="0,14,0,12" />

                        <TextBlock Text="Filter" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="All" MinWidth="44" Margin="0,0,6,6" Padding="8,4" Click="SnapshotTagAll_OnClick" />
                            <Button Content="Manual" MinWidth="64" Margin="0,0,6,6" Padding="8,4" Click="SnapshotTagManual_OnClick" />
                            <Button Content="Batch" MinWidth="64" Margin="0,0,0,6" Padding="8,4" Click="SnapshotTagBatch_OnClick" />
                        </WrapPanel>
                        <TextBlock x:Name="SnapshotTagFilterText" Text="Showing: All" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Button x:Name="SnapshotSidebarCollapsedToggleButton" Grid.Column="1" Content="‹" ToolTip="Toggle sidebar (Ctrl+R)" Visibility="Collapsed" FontSize="18" FontWeight="SemiBold" Width="28" Height="28" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,0,0,0" Click="SnapshotSidebarToggle_OnClick" />
        </Grid>
    </Grid>
</UserControl>
