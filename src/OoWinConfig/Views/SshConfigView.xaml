<UserControl x:Class="OoWinConfig.Views.SshConfigView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource TabContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Source" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SourceComboBox"
                          Grid.Column="1"
                          MinHeight="30"
                          FontSize="12"
                              ItemsSource="{Binding ElementName=Root, Path=Sources}"
                              DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding ElementName=Root, Path=SelectedSource, Mode=TwoWay}"
                              SelectionChanged="SourceComboBox_OnSelectionChanged"
                              ToolTip="{Binding ElementName=Root, Path=SelectedSourcePath}" />

                <WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="Add source" MinHeight="30" Padding="10,4" Margin="0,0,6,0" Click="AddSource_OnClick" />
                    <Button Content="Create file" MinHeight="30" Padding="10,4" Margin="0,0,6,0" Click="CreateSourceFile_OnClick" />
                    <Button Content="Reload" MinHeight="30" Padding="10,4" Margin="0,0,6,0" Click="Reload_OnClick" />
                    <Button Content="Open file" MinHeight="30" Padding="10,4" Margin="0,0,6,0" Click="OpenSourceFile_OnClick" />
                    <Button Content="Save all" MinHeight="30" Padding="10,4" Click="SaveAll_OnClick" />
                </WrapPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="430" />
            </Grid.ColumnDefinitions>

            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Host cards" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="New SSH host" MinWidth="124" MinHeight="30" Padding="10,4" Click="NewHost_OnClick" />
                    </Grid>
                </Border>

                <ListBox x:Name="HostsList"
                         Grid.Row="1"
                         ItemsSource="{Binding ElementName=Root, Path=Hosts}"
                         SelectedItem="{Binding ElementName=Root, Path=SelectedHost, Mode=TwoWay}"
                         SelectionChanged="HostsList_OnSelectionChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="MinHeight" Value="210" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                    <Border DockPanel.Dock="Right" Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="8,3" CornerRadius="12">
                                        <TextBlock Text="{Binding StateLabel}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding HostAlias}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding HostName, TargetNullValue=(no HostName)}" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="User" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding User}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="Port" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Port}" />
                                    <TextBlock Grid.Row="2" Text="Identity" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IdentityFile}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Text="ProxyJump" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ProxyJump}" TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                                    <Border Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="8,3" CornerRadius="12" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding KeyStatus}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                    <Border Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" Padding="8,3" CornerRadius="12" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding TestStatus}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                    </Border>
                                </WrapPanel>

                                <WrapPanel Grid.Row="3">
                                    <Button Content="Edit" MinWidth="64" Margin="0,0,6,6" Click="EditHost_OnClick" />
                                    <Button Content="Test SSH" MinWidth="82" Margin="0,0,6,6" Click="TestHost_OnClick" />
                                    <Button Content="Duplicate" MinWidth="86" Margin="0,0,6,6" Click="DuplicateHost_OnClick" />
                                    <Button Content="{Binding DeleteActionLabel}" MinWidth="104" Margin="0,0,6,6" Click="ToggleDeleteHost_OnClick" />
                                </WrapPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

            <GroupBox Grid.Column="1">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Edit Host card" VerticalAlignment="Center" />
                        <Border Width="18" Height="18" Margin="8,0,0,0" CornerRadius="9" Background="#111721" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" ToolTip="Changes stay local until Save all. Mark delete only stages removal. Unknown directives are preserved in the advanced box.">
                            <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                    </StackPanel>
                </GroupBox.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Common directives" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Edits stay in memory until Save all. Delete also waits for Save all." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="Host" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Host alias used on the ssh command line, for example: ssh kali-dev." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.HostAlias, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="HostName" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Real DNS name or IP address SSH connects to." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.HostName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="User" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Remote username used for this host." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.User, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="Port" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="SSH port. Leave empty to use OpenSSH's default port 22." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="IdentityFile" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Private key path used for this host, such as ~/.ssh/id_ed25519. The app stores the path, not key contents." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.IdentityFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="ProxyJump" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Jump host used before reaching this host. Equivalent to ssh -J." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.ProxyJump, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="ForwardAgent" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Forwards your local SSH agent to the remote host. Use yes only when the remote host must use keys from your agent." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.ForwardAgent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="ServerAliveInterval" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Seconds between keepalive messages sent by SSH. Useful for long-lived connections through unstable networks." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.ServerAliveInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" />

                        <TextBlock Text="StrictHostKeyChecking" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" ToolTip="Controls whether SSH accepts unknown or changed host keys. Safer values are yes or ask." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.StrictHostKeyChecking, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,12" />

                        <TextBlock Text="Advanced / preserved directives" FontWeight="SemiBold" Margin="0,4,0,8" ToolTip="Directives this editor does not model directly. They are kept with the same Host block when saving." />
                        <TextBox Text="{Binding ElementName=Root, Path=SelectedHost.PreservedDirectives, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="110" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                        <WrapPanel>
                            <Button Content="Save all" MinWidth="90" Margin="0,0,8,8" Click="SaveAll_OnClick" />
                            <Button Content="Test SSH" MinWidth="90" Margin="0,0,8,8" Click="TestSelectedHost_OnClick" />
                            <Button Content="{Binding ElementName=Root, Path=SelectedHost.DeleteActionLabel}" MinWidth="112" Margin="0,0,8,8" Click="ToggleSelectedDelete_OnClick" />
                        </WrapPanel>

                        <TextBlock Text="Source details" FontWeight="SemiBold" Margin="0,12,0,8" />
                        <TextBlock Text="Include directives" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ElementName=Root, Path=IncludeDirectivesText}" IsReadOnly="True" AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" />
                        <TextBlock Text="Global directives" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding ElementName=Root, Path=GlobalDirectivesText}" IsReadOnly="True" AcceptsReturn="True" MinHeight="70" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
